{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cli-svckit.example/schema/1/describe.json",
  "title": "describe",
  "description": "Result of `svc describe`: who the tool is and what it supports. Unknown fields are allowed everywhere (must-ignore).",
  "$defs": {
    "params": {
      "type": "object"
    },
    "result": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "contract": {
          "type": "object",
          "properties": {
            "min": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            },
            "max": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "coordination": {
          "type": "object",
          "properties": {
            "kinds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "services": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "phases": {
              "type": "array",
              "items": {
                "enum": [
                  "prepare",
                  "complete"
                ]
              }
            },
            "prepare_timeout_s": {
              "type": "integer",
              "minimum": 0
            },
            "complete_timeout_s": {
              "type": "integer",
              "minimum": 0
            },
            "watches_lease": {
              "type": "boolean"
            }
          },
          "required": [
            "kinds",
            "services",
            "phases",
            "prepare_timeout_s",
            "complete_timeout_s",
            "watches_lease"
          ]
        },
        "doctor": {
          "type": "object",
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "title"
                ]
              }
            }
          },
          "required": [
            "checks"
          ]
        }
      },
      "required": [
        "tool",
        "contract",
        "methods",
        "services"
      ]
    }
  }
}
