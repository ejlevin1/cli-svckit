#!/usr/bin/env bash
# Re-checks every commit being pushed (catches commits made with --no-verify).
set -euo pipefail
z=0000000000000000000000000000000000000000
while read -r _lref lsha _rref rsha; do
  [[ "$lsha" == "$z" ]] && continue                       # branch delete
  if [[ "$rsha" == "$z" ]]; then range="$lsha --not --remotes"; else range="$rsha..$lsha"; fi
  "$(git rev-parse --show-toplevel)/scripts/check-public.sh" --range "$range"
done
